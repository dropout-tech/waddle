<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/huddle_widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical"><TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#3e3e35"/><ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/huddle_mascot" android:contentDescription="Huddle"/></LinearLayout>
 <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#68655d" android:maxLines="1"/>
</LinearLayout>
