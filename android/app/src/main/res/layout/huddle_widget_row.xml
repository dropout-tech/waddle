 <TextView android:id="@+id/row_check" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:textSize="25sp" android:textColor="#a44933" android:contentDescription="完成任務"/>
 <LinearLayout android:id="@+id/row_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical" android:orientation="vertical"><TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:textColor="#3e3e35"/><TextView android:id="@+id/row_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:textColor="#68655d"/></LinearLayout>
